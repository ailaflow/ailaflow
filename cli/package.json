{
  "name": "@ailaflow/cli",
  "version": "0.0.18",
  "description": "AilaFlow is a low-code platform for automating business processes across people, AI agents, and connected systems. Build workflows visually or with AI, coordinate tasks, approvals, and handoffs, and connect your tools with JavaScript.",
  "private": false,
  "type": "module",
  "license": "SEE LICENSE IN LICENSE.md",
  "homepage": "https://ailaflow.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ailaflow/ailaflow.git"
  },
  "bin": {
    "ailaflow": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "node ./dist/cli.mjs",
    "build": "cp ../LICENSE.md ./ && cp ../README.md ./ && node scripts/build.mjs",
    "build:stats": "pnpm build && find dist -type f -exec du -h {} + | sort -h",
    "prepack": "pnpm build",
    "prettier": "prettier --check ./src ./scripts webpack.config.mjs",
    "prettier:fix": "prettier --write ./src ./scripts webpack.config.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "@swc/core": "^1.13.5",
    "@tailwindcss/postcss": "^4.3.0",
    "copy-webpack-plugin": "^13.0.1",
    "css-loader": "^7.1.2",
    "html-webpack-plugin": "^5.6.6",
    "mini-css-extract-plugin": "^2.9.4",
    "postcss": "^8.5.6",
    "postcss-loader": "^8.2.0",
    "prettier": "^3.8.3",
    "swc-loader": "^0.2.6",
    "typescript": "^6.0.3",
    "webpack": "^5.105.0",
    "webpack-cli": "^7.0.0"
  },
  "keywords": [
    "workflow",
    "automation",
    "agent",
    "ai"
  ]
}
