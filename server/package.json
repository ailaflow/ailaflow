{
  "name": "@aila/server",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "start": "tsx watch --env-file=.env src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start:prod": "node dist/main.js",
    "prettier": "prettier --check ./*.json ./*.js ./src",
    "prettier:fix": "prettier --write ./*.json ./*.js ./src",
    "test": "tsx --test --watch",
    "test:single": "tsx --test"
  },
  "dependencies": {
    "@aila/model": "workspace:*",
    "express": "^5.2.1",
    "openai": "^6.39.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.1",
    "prettier": "^3.5.3",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3"
  }
}
